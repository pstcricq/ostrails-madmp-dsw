# Docker-level configuration for the madmp-dsw stack. Copy this file to .env and
# fill in the empty values, docker compose reads .env and nothing else:
#
#   cp .env.example .env
#
# The values that already carry one work as they stand. The empty ones have no
# default and are described where they sit.

# --- DSW image version (keep all three DSW images on the same tag) ---
DSW_VERSION=4.31

# --- The webhook's image ---
# The madmp-core release the webhook runs, as published under
# ghcr.io/pstcricq/ostrails-madmp-core/submission.
MADMP_CORE_VERSION=v1.0.0

# --- Dependency versions (a migration may be needed when upgrading) ---
POSTGRES_VERSION=17.5
MINIO_VERSION=RELEASE.2025-05-24T17-08-30Z
MC_VERSION=RELEASE.2025-05-21T01-59-54Z

# --- Database and credentials ---
# The database and both accounts are created on first start from these five
# values. The names work as they stand, the passwords are yours to choose:
#
#   openssl rand -hex 24
#
# (!!) MinIO refuses a password under 8 characters, or a username under 3.
# (!!) The Postgres password ends up inside a postgresql:// URI, so a character
# that is special in a URL has to be percent-encoded here.
# (!!) Postgres applies its password at the very first initdb only. Changing it
# later takes a `docker compose down -v`.
POSTGRES_DB=engine-wizard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=

# --- The three URLs, as the browser reaches them ---
# What the *user's machine* resolves. The values below are those of a local
# Docker Desktop. Anywhere else, replace all three with the addresses a browser
# uses to reach this stack.
#
# (!!) S3_URL has to resolve from the containers and from the browser at once,
# being both the address of the object storage and what goes inside the
# presigned download URLs. host.docker.internal manages both on Docker Desktop.
API_URL=http://localhost:3000/wizard-api
CLIENT_URL=http://localhost:8080/wizard
S3_URL=http://host.docker.internal:9000

# --- Object storage ---
# The bucket documents are written into. Any name works, as long as it is set.
S3_BUCKET=engine-wizard

# --- Submission webhook (DSW Submit -> the registry) ---
# All four are required, and read once when the webhook starts.
#
# SUBMISSION_TOKEN is the shared secret DSW sends as "Authorization: Bearer ...",
# and the same value has to be configured in DSW:
#
#   openssl rand -hex 24
SUBMISSION_TOKEN=
# Fine-grained PAT, Contents RW + Metadata R on the registry repo.
REGISTRY_TOKEN=
# The account owning the registry repo, and the repo itself.
REGISTRY_OWNER=
REGISTRY_REPO=

# --- DSW signing secrets ---
# Never inherit these from anywhere, an example included. Whoever holds them can
# forge a valid token against this instance.
#
#   GENERAL_SECRET           openssl rand -hex 16
#   GENERAL_RSA_PRIVATE_KEY  openssl genrsa -traditional 4096
#
# (!!) -hex 16 and not more, the secret must be exactly 32 ASCII characters.
# (!!) -traditional produces the PKCS#1 form, the one starting with "BEGIN RSA
# PRIVATE KEY". OpenSSL 3 defaults to PKCS#8.
#
# The key is the one multi-line value. Paste it between double quotes, keeping
# its line breaks:
#
#   GENERAL_RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
#   MIIJKAIBAAKCAgEAyMMyCZe...
#   -----END RSA PRIVATE KEY-----"
GENERAL_SECRET=
GENERAL_RSA_PRIVATE_KEY=
