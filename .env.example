# Docker-level configuration for the madmp-dsw stack. Copy this file to .env and
# fill in the empty values, docker compose reads .env and nothing else:
#
#   cp .env.example .env
#
# The values that already carry one work as they stand. The empty ones have no
# default and are described where they sit. One block per thing configured, each
# opening on the version of the image that runs it.

# --- Data Stewardship Wizard ---
# One tag for all three DSW images.
#
# The two secrets sign the tokens this instance issues. Never inherit them from
# anywhere, an example included, whoever holds them can forge a valid token
# against this instance:
#
#   GENERAL_SECRET           openssl rand -hex 16
#   GENERAL_RSA_PRIVATE_KEY  openssl genrsa -traditional 4096
#
# (!!) -hex 16 and not more, the secret must be exactly 32 ASCII characters.
# (!!) -traditional produces the PKCS#1 form, the one starting with "BEGIN RSA
# PRIVATE KEY". OpenSSL 3 defaults to PKCS#8.
#
# The key is the one multi-line value. Paste it between double quotes, keeping
# its line breaks:
#
#   GENERAL_RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
#   MIIJKAIBAAKCAgEAyMMyCZe...
#   -----END RSA PRIVATE KEY-----"
DSW_VERSION=4.31
GENERAL_SECRET=
GENERAL_RSA_PRIVATE_KEY=

# --- Database ---
# The database and its account are created on first start from these three
# values. The names work as they stand, the password is yours to choose:
#
#   openssl rand -hex 24
#
# (!!) The password ends up inside a postgresql:// URI, so a character that is
# special in a URL has to be percent-encoded here.
# (!!) It is applied at the very first initdb only. Changing it later takes a
# `docker compose down -v`.
POSTGRES_VERSION=17.5
POSTGRES_DB=engine-wizard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# --- Object storage ---
# Two images, MinIO itself and the mc client that creates the bucket, each on
# its own release schedule. The account is created on first start, the password
# is yours to choose:
#
#   openssl rand -hex 24
#
# (!!) MinIO refuses a password under 8 characters, or a username under 3.
MINIO_VERSION=RELEASE.2025-05-24T17-08-30Z
MC_VERSION=RELEASE.2025-05-21T01-59-54Z
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=
S3_BUCKET=engine-wizard

# --- Submission webhook ---
# MADMP_CORE_VERSION is the madmp-core release the webhook runs, as published
# under ghcr.io/pstcricq/ostrails-madmp-core/submission.
#
# The four below are required, and read once when the webhook starts.
# SUBMISSION_TOKEN is the shared secret DSW sends as "Authorization: Bearer ...",
# and the same value has to be configured in DSW:
#
#   openssl rand -hex 24
#
# REGISTRY_TOKEN is a fine-grained PAT, Contents RW + Metadata R on the registry
# repository, and the last two name the account owning it and the repository
# itself.
MADMP_CORE_VERSION=v1.0.1
SUBMISSION_TOKEN=
REGISTRY_TOKEN=
REGISTRY_OWNER=
REGISTRY_REPO=

# --- The three URLs, as the browser reaches them ---
# What the *user's machine* resolves, and the three values that change when this
# stack is deployed anywhere else. Those below are a local Docker Desktop.
#
# (!!) S3_URL has to resolve from the containers and from the browser at once,
# being both the address of the object storage and what goes inside the
# presigned download URLs. host.docker.internal manages both on Docker Desktop.
API_URL=http://localhost:3000/wizard-api
CLIENT_URL=http://localhost:8080/wizard
S3_URL=http://host.docker.internal:9000
