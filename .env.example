# Docker-level configuration for the madmp-dsw stack. Copy this file to .env and
# fill in the empty values, docker compose reads .env and nothing else:
#
#   cp .env.example .env
#
# The eleven values that already carry one work as they stand. The eight empty
# ones have no default and are described where they sit.

# --- DSW image version (keep all three DSW images on the same tag) ---
DSW_VERSION=4.31

# --- Dependency versions (a migration may be needed when upgrading) ---
# The mc client is a separate image on its own release schedule, so it carries
# its own version rather than MinIO's.
POSTGRES_VERSION=17.5
MINIO_VERSION=RELEASE.2025-05-24T17-08-30Z
MC_VERSION=RELEASE.2025-05-21T01-59-54Z

# --- Database and credentials ---
# The database and both accounts are created on first start from these five
# values. The names work as they stand, the passwords are yours to choose. To
# generate one:
#
#   openssl rand -hex 24
#
# (!!) MinIO refuses to start on a password shorter than 8 characters, or on a
# username shorter than 3.
# (!!) The Postgres password ends up inside a postgresql:// URI, so a character
# that is special in a URL has to be percent-encoded here, or the connection
# fails in a way that does not name the cause.
# (!!) Postgres applies its password once, at the very first initdb. Changing it
# later has no effect on an existing database, it takes a `docker compose down
# -v` to start over.
POSTGRES_DB=engine-wizard
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=

# --- The three URLs, as the browser reaches them ---
# These are what the *user's machine* resolves, so they depend on where the
# stack runs. The values below are those of a local Docker Desktop. Anywhere
# else, replace all three with the addresses a browser uses to reach this stack.
#
# S3_URL is the awkward one: DSW has a single setting for MinIO, and it is also
# what goes inside the presigned download URLs handed to the browser, so it has
# to resolve from the containers and from the browser at once.
# host.docker.internal manages both on Docker Desktop, where the host resolves
# it to 127.0.0.1 and the containers get it through extra_hosts.
API_URL=http://localhost:3000/wizard-api
CLIENT_URL=http://localhost:8080/wizard
S3_URL=http://host.docker.internal:9000

# --- Object storage ---
# The bucket DSW writes into, and the one the createbucket service creates. They
# read this same value, so any name works as long as it is set.
S3_BUCKET=engine-wizard

# --- Submission webhook (DSW Submit -> dmp-registry) ---
# The webhook reads these four at startup and refuses to serve when one is
# empty, so the container restarts in a loop rather than answer /health with a
# promise it cannot keep. Its log names every variable that is missing.
#
# SUBMISSION_TOKEN is the shared secret DSW sends as "Authorization: Bearer ...".
# The same value has to reach DSW, where madmp-core's `dsw.publish submission`
# writes it. To generate one:
#
#   openssl rand -hex 24
SUBMISSION_TOKEN=
# Fine-grained PAT, Contents RW + Metadata R on the registry repo.
REGISTRY_TOKEN=
# The account owning the registry repo, and the repo itself.
REGISTRY_OWNER=
REGISTRY_REPO=

# --- DSW signing secrets ---
# Never inherit these from anywhere, an example included. Whoever holds them can
# forge a valid token against this instance.
#
#   GENERAL_SECRET           openssl rand -hex 16
#   GENERAL_RSA_PRIVATE_KEY  openssl genrsa -traditional 4096
#
# (!!) -hex 16 and not more: the secret must be exactly 32 ASCII characters, and
# the server refuses to start on anything else.
# (!!) -traditional produces the PKCS#1 form, the one starting with "BEGIN RSA
# PRIVATE KEY", which is what DSW expects. OpenSSL 3 defaults to PKCS#8.
#
# The key is the one multi-line value. Paste it between double quotes, keeping
# its line breaks, which docker compose reads correctly:
#
#   GENERAL_RSA_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----
#   MIIJKAIBAAKCAgEAyMMyCZe...
#   -----END RSA PRIVATE KEY-----"
GENERAL_SECRET=
GENERAL_RSA_PRIVATE_KEY=

# --- Building the webhook's image ---
# Read once, when the image is built, to install madmp-core from its private
# repository. Not needed to run the stack, and never stored in the image.
# Fine-grained token, Contents: Read on ostrails-madmp-core.
MADMP_CORE_TOKEN=
